generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations take a Postgres advisory lock, which Neon's pooled connection
  // times out on; they use the direct connection instead.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  employee
  team_leader
  manager
  hr
  admin
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  passwordSet           Boolean                @default(true)
  // false until HR/Admin activates a new hire's account (Onboarding). An
  // inactive account can't log in or use password-reset links.
  active                Boolean                @default(true)
  firstName             String
  middleName            String?
  lastName              String
  roles                 Role[]                 @default([employee])
  // Per-user settings (notification preferences). Shape: { disabledNotifications?: string[] }
  settings              Json                   @default("{}")
  notifications         Notification[]
  devices               Device[]
  deviceCodes           DeviceCode[]
  announcementReactions AnnouncementReaction[]
  announcementAcks      AnnouncementAck[]
  announcementRsvps     AnnouncementRsvp[]
  employee              Employee?
  resetTokens           PasswordResetToken[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  teams     Team[]
  employees Employee[]

  @@map("departments")
}

model Team {
  id            String         @id @default(uuid())
  name          String
  department    Department     @relation(fields: [departmentId], references: [id])
  departmentId  String
  employees     Employee[]
  weeklyReports WeeklyReport[]

  @@map("teams")
}

model Employee {
  id           String      @id @default(uuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String      @unique
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  team         Team?       @relation(fields: [teamId], references: [id])
  teamId       String?
  position     String?
  status       String      @default("active")
  dateHired    DateTime?
  // Supervisor: another Employee. Set by HR/Admin.
  managerId    String?
  manager      Employee?   @relation("Supervisor", fields: [managerId], references: [id], onDelete: SetNull)
  supervisees  Employee[]  @relation("Supervisor")
  silBalance   Int         @default(5)

  // Self-service contact details: the employee edits their own; HR/Admin
  // can view them. Nothing else in the API returns these.
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // Personal details the employee fills in (optional). Visible to the
  // employee and HR/Admin only, like the contact details.
  birthDate             DateTime?
  // male | female | other | prefer_not_to_say
  gender                String?

  // HR record fields (Employee Management). salary is HR/Admin only and is
  // never included in self-service (/employees/me) responses.
  employeeCode           String?   @unique
  // Shown on the employee's header card (from the old spreadsheet).
  legalEntity            String?
  level                  String?
  probationEndDate       DateTime?
  regularizationDate     DateTime?
  salary                 Decimal?  @db.Decimal(12, 2)
  // [{ name, number?, status: "pending" | "submitted" | "verified" }]
  governmentRequirements Json      @default("[]")

  leaveRequests      LeaveRequest[]
  attendanceRecords  AttendanceRecord[]
  dependents         Dependent[]
  employmentHistory  EmploymentHistory[]
  documents          Document[]
  hrRequests         HrRequest[]
  todos              Todo[]
  kpiScores          KpiScore[]
  inventoryItems     InventoryItem[]
  shiftAssignments   ShiftAssignment[]
  benefitEnrollments BenefitEnrollment[]
  checklists         Checklist[]
  performanceReviews PerformanceReview[]
  performanceNotes   PerformanceNote[]
  disciplinaryCases  DisciplinaryCase[]
  salaryChanges      SalaryChange[]
  payItems           PayItem[]
  payslips           Payslip[]

  @@map("employees")
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id            String             @id @default(uuid())
  employee      Employee           @relation(fields: [employeeId], references: [id])
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  useSil        Boolean            @default(false)
  status        LeaveRequestStatus @default(pending)
  reviewedBy    String?
  reviewComment String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("leave_requests")
}

enum AttendanceStatus {
  present
  absent
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  employee       Employee         @relation(fields: [employeeId], references: [id])
  employeeId     String
  date           DateTime // the calendar day this record is for, normalized to midnight Asia/Manila
  status         AttendanceStatus @default(present)
  checkInAt      DateTime? // null for a record HR marked absent
  checkOutAt     DateTime?
  checkInIp      String? // client IP at check-in, for HR to spot off-site logins
  checkOutIp     String?
  markedBy       String? // userId of the HR/admin who marked this absent, if applicable
  // Entered by HR (no shift schedule to compute them from): the weekly tracker's
  // OverTime and Working Holiday rows.
  overtimeHours  Decimal?         @db.Decimal(4, 2)
  workingHoliday Boolean          @default(false)
  // Breaks and lunch taken on the desktop app: [{ slot, status, startedAt, endedAt, overSeconds }]. See lib/breaks.ts.
  breaks         Json             @default("[]")
  createdAt      DateTime         @default(now())

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model Announcement {
  id          String                 @id @default(uuid())
  title       String
  content     String
  authorId    String
  category    String                 @default("Company announcements")
  published   Boolean                @default(false)
  // HR/Admin pinned it: shown first on the portal and on the BPO Time app. Emergency announcements count as
  // highlighted without this flag (see `featured` in the announcements handler).
  highlighted Boolean                @default(false)
  // When the highlight ends on its own. Null (with highlighted) = until HR removes it.
  highlightUntil DateTime?
  // Asks people to do something by actionDueAt: each active employee gets a to-do tied to this announcement.
  needsAction Boolean @default(false)
  actionDueAt DateTime?
  // { teamIds, employeeIds } the action is for; null = everyone.
  actionAudience Json?
  // The deadline's time of day ('HH:mm') and the zone it is in, when it has one (actionDueAt is just the day).
  actionDueTime String?
  actionDueZone String?
  // An event: its day (date-only), time ('HH:mm') and zone ('Asia/Manila' | 'America/Los_Angeles'), place, and whether it is
  // mandatory (joining is assumed once the person has pressed Got it, unless they say they cannot make it). The Calendar entry
  // made for it is kept in calendarEventId.
  isEvent Boolean @default(false)
  eventDate DateTime?
  eventTime String?
  eventZone String?
  eventPlace String?
  eventMandatory Boolean @default(false)
  calendarEventId String?
  publishAt   DateTime?
  expireAt    DateTime?
  createdAt   DateTime               @default(now())
  reactions   AnnouncementReaction[]
  acks        AnnouncementAck[]
  rsvps       AnnouncementRsvp[]

  @@map("announcements")
}

// One reaction (a thumbs up, heart or party popper) per person per announcement.
// Whether a person is joining an event (joining true or false), with an optional reason when they cannot.
model AnnouncementRsvp {
  id             String       @id @default(uuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  joining        Boolean
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_rsvps")
}

model AnnouncementReaction {
  id             String       @id @default(uuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reactions")
}

// "Got it": a person confirming they have read an announcement that needs it (policies, important and
// emergency notices). HR sees who has and who has not.
model AnnouncementAck {
  id             String       @id @default(uuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  ackedAt        DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_acks")
}

model Benefit {
  id              String              @id @default(uuid())
  title           String
  category        String
  description     String
  eligibility     String?
  provider        String?
  providerContact String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  enrollments     BenefitEnrollment[]

  @@map("benefits")
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  documents Document[]

  @@map("document_categories")
}

model Document {
  id          String           @id @default(uuid())
  title       String
  category    DocumentCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  storageKey  String
  accessLevel Role             @default(employee)
  uploadedBy  String
  // Set for a file that belongs to one employee (Employee Management ->
  // Employee documents); such a file is visible only to that employee's
  // record managers (HR/Admin), never through the company Documents list.
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String?
  createdAt   DateTime         @default(now())

  @@map("documents")
}

enum ReportStatus {
  draft
  submitted
  reviewed
  approved
  rejected
}

model WeeklyReport {
  id          String       @id @default(uuid())
  team        Team         @relation(fields: [teamId], references: [id])
  teamId      String
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(draft)
  submittedBy String?
  // Which report form/shape `data` follows — "generic" (the original
  // free-text fields) or a department-specific key like "foa". Determined
  // server-side from the team's department at creation time, never trusted
  // from the client.
  schemaKey   String       @default("generic")
  // Set only for individually-authored reports (e.g. "foa", where each
  // employee files their own weekly report). Null for generic team-wide
  // reports. Distinct from submittedBy, which is only set once submitted —
  // this identifies the owner from creation, for draft-stage permissions.
  authorId    String?
  data        Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("weekly_reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  result     String
  // What it was about, in words: who it affected and what changed.
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // Machine-readable kind, e.g. "leave_approved" — also what a user's
  // notification preferences key on.
  type      String
  title     String
  body      String?
  // In-app route to open when clicked, e.g. "/leave".
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  // holiday | event | meeting | training | deadline
  kind        String
  // Date-only values (midnight UTC), like attendance dates.
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdBy   String
  // hr (typed in by HR) | nager (prefilled national holiday, see lib/holidays.ts)
  source      String    @default("hr")
  // 'nager:2026-12-25' for imported rows, so the import can run twice without duplicating.
  externalKey String?   @unique
  // HR marked this prefilled holiday as not a holiday. Kept (not deleted) so the import does not re-add it.
  disabled    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([startDate])
  @@map("calendar_events")
}

model Dependent {
  id           String    @id @default(uuid())
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  name         String
  relationship String
  birthDate    DateTime?
  createdAt    DateTime  @default(now())

  @@index([employeeId])
  @@map("dependents")
}

model EmploymentHistory {
  id         String    @id @default(uuid())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  title      String
  department String?
  startDate  DateTime
  endDate    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@map("employment_history")
}

// Employee-submitted HR requests. status: pending -> processing ->
// completed -> closed.
model HrRequest {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  // certificate_of_employment | salary_certificate | employment_verification
  // | document_request | benefit_concern | hr_concern | other
  type       String
  subject    String
  details    String?
  status     String   @default("pending")
  resolution String?
  handledBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("hr_requests")
}

model BenefitEnrollment {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId    String
  benefit       Benefit   @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  benefitId     String
  // enrolled | pending | waived | terminated
  status        String    @default("pending")
  effectiveDate DateTime?
  endDate       DateTime?
  dependentIds  String[]
  notes         String?
  // [{ at, by, action, detail? }] — every change, newest last.
  history       Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, benefitId])
  @@map("benefit_enrollments")
}

// Onboarding and offboarding share one checklist shape. kind is
// "onboarding" or "offboarding".
model Checklist {
  id             String          @id @default(uuid())
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String
  kind           String
  // open | completed
  status         String          @default("open")
  // Offboarding only: resignation | termination, and the last working day.
  separationType String?
  effectiveDate  DateTime?
  notes          String?
  createdBy      String
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  tasks          ChecklistTask[]

  @@index([employeeId, kind])
  @@map("checklists")
}

model ChecklistTask {
  id          String    @id @default(uuid())
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  label       String
  position    Int
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneBy      String?
  note        String?

  @@index([checklistId])
  @@map("checklist_tasks")
}

model JobOpening {
  id          String      @id @default(uuid())
  title       String
  department  String?
  description String?
  // open | on_hold | closed
  status      String      @default("open")
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  // Optional banner image (object key in storage; served by short-lived URLs).
  bannerKey   String?
  // Soft delete: hidden everywhere, kept in the database.
  deletedAt   DateTime?
  applicants  Applicant[]

  @@map("job_openings")
}

model Applicant {
  id           String      @id @default(uuid())
  jobOpening   JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  jobOpeningId String
  // name is "First Middle Last", kept in step with the parts below.
  name         String
  firstName    String?
  middleName   String?
  lastName     String?
  email        String?
  phone        String?
  birthDate    DateTime?
  // male | female | other | prefer_not_to_say
  gender       String?
  // Free-text applicant information (background, source, expected salary…).
  information  String?
  // applied | screening | interview | offer | hired | rejected | withdrawn
  status       String      @default("applied")
  decisionNote String?
  decidedAt    DateTime?
  // internal (entered by HR) | careers (applied on the public page)
  source       String      @default("internal")
  resumeLink   String?
  // An uploaded resume (PDF/Word) stored in the bucket, from the careers page.
  resumeKey    String?
  resumeName   String?
  // Who referred this applicant, as the applicant typed it on the careers page.
  referrerName String?
  // Older applicants picked an employee from a list; kept so they still display.
  referredById String?
  // Set when this applicant was turned into an employee through Onboarding.
  hiredUserId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  interviews   Interview[]

  @@index([jobOpeningId])
  @@map("applicants")
}

model Interview {
  id          String    @id @default(uuid())
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId String
  scheduledAt DateTime
  interviewer String?
  // Notes are HR-only; written after the interview.
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([applicantId])
  @@map("interviews")
}

// One evaluation cycle for one employee. status: self_assessment ->
// supervisor_evaluation -> hr_review -> completed.
model PerformanceReview {
  id                   String   @id @default(uuid())
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId           String
  period               String
  status               String   @default("self_assessment")
  selfAssessment       String?
  supervisorEvaluation String?
  supervisorRating     Int?
  hrReview             String?
  finalRating          Int?
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([employeeId])
  @@map("performance_reviews")
}

// kind: "coaching" | "improvement_plan"
model PerformanceNote {
  id         String    @id @default(uuid())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  kind       String
  title      String
  details    String?
  // active | completed
  status     String    @default("active")
  dueDate    DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@map("performance_notes")
}

// HR-only. Never exposed to the employee or to non-HR roles.
model DisciplinaryCase {
  id                  String   @id @default(uuid())
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId          String
  title               String
  incidentDate        DateTime
  incidentReport      String
  employeeExplanation String?
  // none | written | final
  warningLevel        String   @default("none")
  correctiveAction    String?
  // open | under_review | resolved | closed
  status              String   @default("open")
  // [{ name, key }] — storage keys of supporting documents.
  documents           Json     @default("[]")
  // [{ at, by, action, detail? }] — timeline, newest last.
  history             Json     @default("[]")
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([employeeId])
  @@map("disciplinary_cases")
}

model SalaryChange {
  id             String   @id @default(uuid())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String
  effectiveDate  DateTime
  previousSalary Decimal? @db.Decimal(12, 2)
  newSalary      Decimal  @db.Decimal(12, 2)
  reason         String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([employeeId])
  @@map("salary_changes")
}

// kind: "allowance" | "bonus" | "deduction"
model PayItem {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  kind       String
  label      String
  amount     Decimal  @db.Decimal(12, 2)
  // Date it applies to (bonus paid, deduction taken, allowance start).
  date       DateTime
  recurring  Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@map("pay_items")
}

model Payslip {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  // Amounts are optional: HR usually just records the payslip link.
  gross       Decimal? @db.Decimal(12, 2)
  deductions  Decimal? @db.Decimal(12, 2)
  net         Decimal? @db.Decimal(12, 2)
  // Link to the payslip in Google Drive (access is decided by Drive sharing).
  link        String?
  // Legacy: PDFs uploaded to storage before payslips became links.
  fileKey     String?
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@map("payslips")
}

// A to-do assigned to an employee by HR or their supervisor (the old
// spreadsheet's "To Do's": task, due date, linked document).
model Todo {
  id          String        @id @default(uuid())
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  title       String
  // Longer instructions or context for the task (optional).
  description String?
  dueDate     DateTime?
  link        String?
  // open | done
  status      String        @default("open")
  completedAt DateTime?
  // User ids: who finished it, and who assigned it (createdBy).
  completedBy String?
  // low | normal | urgent
  priority    String        @default("normal")
  // Soft delete: hidden everywhere, kept in the database.
  deletedAt   DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  // Set when the to-do came from an announcement that needs action (see the announcements handler).
  announcementId String?
  comments    TodoComment[]

  @@index([employeeId, status])
  @@index([createdBy])
  @@index([announcementId])
  @@map("todos")
}

// Updates on a to-do, written by the assignee, whoever assigned it, or HR.
model TodoComment {
  id        String   @id @default(uuid())
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([todoId])
  @@map("todo_comments")
}

// KPI scorecard (the old spreadsheet's "KPI Metrics"): HR-managed criteria
// grouped by core value, scored per employee per month. The scale and how
// totals are computed live in portal_settings under the key "kpi".
model KpiCriterion {
  id        String     @id @default(uuid())
  coreValue String
  name      String
  weight    Float      @default(1)
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  scores    KpiScore[]
  createdAt DateTime   @default(now())

  @@map("kpi_criteria")
}

model KpiScore {
  id          String       @id @default(uuid())
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  criterion   KpiCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  criterionId String
  year        Int
  month       Int
  score       Float
  scoredBy    String
  updatedAt   DateTime     @updatedAt

  @@unique([employeeId, criterionId, year, month])
  @@index([employeeId, year])
  @@map("kpi_scores")
}

// Freedom Wall: anonymous posts everyone can read. There is deliberately NO
// author column — who posted is never stored, here or in the audit log.
model FreedomPost {
  id        String            @id @default(uuid())
  body      String
  // The random display name picked for this post ("Anonymous Sleepy Koala").
  // Never derived from the author.
  alias     String?
  hidden    Boolean           @default(false)
  createdAt DateTime          @default(now())
  reactions FreedomReaction[]

  @@index([createdAt])
  @@map("freedom_posts")
}

// One reaction per person per post. reactorKey is an HMAC of the user and the
// post, not the user id, so the table cannot be read back to a person.
model FreedomReaction {
  id         String      @id @default(uuid())
  post       FreedomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  reactorKey String
  emoji      String
  createdAt  DateTime    @default(now())

  @@unique([postId, reactorKey])
  @@map("freedom_reactions")
}

// Company inventory: every item has at most ONE current holder (a nullable
// FK), while one employee can hold many items. InventoryAssignment keeps the
// full history. assetTag is what the QR sticker encodes.
model InventoryItem {
  id                 String                @id @default(uuid())
  assetTag           String                @unique
  name               String
  category           String?
  serialNumber       String?
  // The sticker's "Brand / model" and "Date of purchase".
  brandModel         String?
  purchaseDate       DateTime?
  // available | assigned | repair | lost | retired
  status             String                @default("available")
  notes              String?
  assignedTo         Employee?             @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId       String?
  // Latest monthly-check result: good | fair | poor | damaged
  condition          String?
  conditionCheckedAt DateTime?
  // Soft delete: hidden everywhere, kept in the database.
  deletedAt          DateTime?
  createdBy          String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  assignments        InventoryAssignment[]
  checks             InventoryCheck[]

  @@index([assignedToId])
  @@map("inventory_items")
}

// One condition check per item per month ("YYYY-MM", Manila time).
model InventoryCheck {
  id        String        @id @default(uuid())
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  month     String
  condition String
  note      String?
  checkedBy String
  checkedAt DateTime      @default(now())

  @@unique([itemId, month])
  @@map("inventory_checks")
}

model InventoryAssignment {
  id         String        @id @default(uuid())
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  employeeId String
  assignedAt DateTime      @default(now())
  assignedBy String
  returnedAt DateTime?
  returnNote String?

  @@index([itemId])
  @@index([employeeId])
  @@map("inventory_assignments")
}

// Shift schedules, managed by HR. Late / undertime / overtime are measured
// against the shift that applies to an attendance date.
model Shift {
  id           String            @id @default(uuid())
  name         String
  // "HH:MM" in Manila time. endTime <= startTime means the shift crosses midnight.
  startTime    String
  endTime      String
  // 0 = Sunday ... 6 = Saturday
  workDays     Int[]
  breakMinutes Int               @default(0)
  graceMinutes Int               @default(0)
  // The time zone startTime and endTime are written in. A California shift follows California's daylight saving
  // by itself; its Philippines hours move by an hour when California changes the clocks. Allowed: Asia/Manila, America/Los_Angeles.
  timezone     String            @default("Asia/Manila")
  // The shift new employees start on (only one at a time).
  isDefault    Boolean           @default(false)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  assignments  ShiftAssignment[]

  @@map("shifts")
}

// The shift an employee works from effectiveFrom (a date, midnight UTC)
// until their next assignment.
model ShiftAssignment {
  id            String   @id @default(uuid())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId    String
  shift         Shift    @relation(fields: [shiftId], references: [id])
  shiftId       String
  effectiveFrom DateTime
  assignedBy    String
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveFrom])
  @@map("shift_assignments")
}

// Portal-wide settings kept as JSON, keyed by name. Currently just "menu":
// the admin's sidebar overrides (labels, order, visibility, roles).
model PortalSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("portal_settings")
}

// A PC the desktop app (BPO Time) has been connected from. The app holds an
// opaque token; only its SHA-256 is stored here, so a database leak cannot be
// used to act as a device. Revoking sets revokedAt and the token stops working.
model Device {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@map("devices")
}

// A short-lived, single-use code the portal hands to the app (through the
// bpotime:// link) so the app can sign in without a password. Only a hash is stored.
model DeviceCode {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("device_codes")
}
