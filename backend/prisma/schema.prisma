generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  employee
  team_leader
  manager
  hr
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  passwordSet  Boolean  @default(true)
  firstName    String
  middleName   String?
  lastName     String
  roles        Role[]   @default([employee])
  employee     Employee?
  resetTokens  PasswordResetToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  teams     Team[]
  employees Employee[]

  @@map("departments")
}

model Team {
  id            String         @id @default(uuid())
  name          String
  department    Department     @relation(fields: [departmentId], references: [id])
  departmentId  String
  employees     Employee[]
  weeklyReports WeeklyReport[]

  @@map("teams")
}

model Employee {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @unique
  department Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  team       Team?     @relation(fields: [teamId], references: [id])
  teamId     String?
  position   String?
  status     String    @default("active")
  dateHired  DateTime?
  managerId  String?
  silBalance Int       @default(5)

  // Self-service contact details: the employee edits their own; HR/Admin
  // can view them. Nothing else in the API returns these.
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]

  @@map("employees")
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id            String             @id @default(uuid())
  employee      Employee           @relation(fields: [employeeId], references: [id])
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  useSil        Boolean            @default(false)
  status        LeaveRequestStatus @default(pending)
  reviewedBy    String?
  reviewComment String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("leave_requests")
}

enum AttendanceStatus {
  present
  absent
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employee   Employee         @relation(fields: [employeeId], references: [id])
  employeeId String
  date       DateTime         // the calendar day this record is for, normalized to midnight Asia/Manila
  status     AttendanceStatus @default(present)
  checkInAt  DateTime?        // null for a record HR marked absent
  checkOutAt DateTime?
  checkInIp  String?          // client IP at check-in, for HR to spot off-site logins
  checkOutIp String?
  markedBy   String?          // userId of the HR/admin who marked this absent, if applicable
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  authorId  String
  published Boolean   @default(false)
  publishAt DateTime?
  expireAt  DateTime?
  createdAt DateTime  @default(now())

  @@map("announcements")
}

model Benefit {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String
  eligibility String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  documents Document[]

  @@map("document_categories")
}

model Document {
  id          String            @id @default(uuid())
  title       String
  category    DocumentCategory  @relation(fields: [categoryId], references: [id])
  categoryId  String
  storageKey  String
  accessLevel Role              @default(employee)
  uploadedBy  String
  createdAt   DateTime          @default(now())

  @@map("documents")
}

enum ReportStatus {
  draft
  submitted
  reviewed
  approved
  rejected
}

model WeeklyReport {
  id          String       @id @default(uuid())
  team        Team         @relation(fields: [teamId], references: [id])
  teamId      String
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(draft)
  submittedBy String?
  data        Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("weekly_reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  result     String
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
