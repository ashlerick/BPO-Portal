{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "devCommand": null,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth/forgot-password", "destination": "/api/auth/set-password?action=forgot" },
    { "source": "/api/auth/admin-reset-password", "destination": "/api/auth/set-password?action=admin-reset" },
    { "source": "/api/auth/change-password", "destination": "/api/auth/set-password?action=change" },
    { "source": "/api/employees/me", "destination": "/api/employees?sub=me" },
    { "source": "/api/employees/:id", "destination": "/api/employees?sub=:id" },
    { "source": "/api/users/:id", "destination": "/api/users?sub=:id" },
    { "source": "/api/documents/:id/download", "destination": "/api/documents?sub=:id" },
    { "source": "/api/announcements", "destination": "/api/content?resource=announcements" },
    { "source": "/api/announcements/:id", "destination": "/api/content?resource=announcements&sub=:id" },
    { "source": "/api/benefits", "destination": "/api/content?resource=benefits" },
    { "source": "/api/benefits/:id", "destination": "/api/content?resource=benefits&sub=:id" },
    { "source": "/api/me", "destination": "/api/portal?resource=me" },
    { "source": "/api/audit-logs", "destination": "/api/portal?resource=audit-logs" },
    { "source": "/api/notifications", "destination": "/api/portal?resource=notifications" },
    { "source": "/api/notifications/:id", "destination": "/api/portal?resource=notifications&sub=:id" },
    { "source": "/api/calendar", "destination": "/api/portal?resource=calendar" },
    { "source": "/api/calendar/:id", "destination": "/api/portal?resource=calendar&sub=:id" },
    { "source": "/api/settings", "destination": "/api/portal?resource=settings" },
    { "source": "/api/menu", "destination": "/api/portal?resource=menu" },
    { "source": "/api/hr/:resource", "destination": "/api/hr?resource=:resource" },
    { "source": "/api/hr/:resource/:id", "destination": "/api/hr?resource=:resource&sub=:id" },
    { "source": "/api/restricted/:resource", "destination": "/api/restricted?resource=:resource" },
    { "source": "/api/restricted/:resource/:id", "destination": "/api/restricted?resource=:resource&sub=:id" },
    { "source": "/api/reports/:id/export", "destination": "/api/reports?sub=:id" },
    { "source": "/api/reports/:id", "destination": "/api/reports?sub=:id" },
    { "source": "/api/leave/requests", "destination": "/api/leave?resource=requests" },
    { "source": "/api/leave/requests/:id", "destination": "/api/leave?resource=requests&sub=:id" },
    { "source": "/api/leave/attendance", "destination": "/api/leave?resource=attendance" },
    { "source": "/api/leave/attendance/today", "destination": "/api/leave?resource=attendance&sub=today" },
    { "source": "/api/leave/attendance/checkin", "destination": "/api/leave?resource=attendance&sub=checkin" },
    { "source": "/api/leave/attendance/checkout", "destination": "/api/leave?resource=attendance&sub=checkout" },
    { "source": "/api/leave/attendance/export", "destination": "/api/leave?resource=attendance&sub=export" },
    { "source": "/api/leave/attendance/mark-absent", "destination": "/api/leave?resource=attendance&sub=mark-absent" },
    { "source": "/api/leave/attendance/correct", "destination": "/api/leave?resource=attendance&sub=correct" },
    { "source": "/api/leave/attendance/:id", "destination": "/api/leave?resource=attendance&sub=:id" },
    { "source": "/api/directory/departments/:id", "destination": "/api/directory?kind=department&sub=:id" },
    { "source": "/api/directory/teams/:id", "destination": "/api/directory?kind=team&sub=:id" }
  ]
}
