# PostgreSQL connection string (from Neon/Supabase/etc.)
DATABASE_URL=postgresql://user:password@host:5432/bpo_portal

# Long random string used to sign JWTs (openssl rand -base64 48)
JWT_SECRET=

# Origin allowed to call this API (your GitHub Pages URL). Use * only in local dev.
CORS_ORIGIN=http://localhost:4300

# Base URL of the deployed frontend, no trailing slash — used to build
# links sent in emails (e.g. account setup links)
FRONTEND_URL=http://localhost:4300

# Used by the seed script to create the first admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# S3-compatible object storage (Backblaze B2). Any S3-compatible
# provider works here, not just AWS — just change the endpoint.
S3_ENDPOINT=s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Gmail API sending (OAuth, via scripts/gmail-oauth-setup.mjs)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Optional, comma-separated public IPs of the office network. When set,
# HR sees an "(off-site)" flag next to any check-in whose IP isn't in
# this list. Leave unset to disable the flag entirely. Every check-in
# IP is logged regardless of whether this is set — tell employees this
# is happening (e.g. in the employee handbook) before enabling it.
OFFICE_IPS=

# Secret Vercel sends to the monthly inventory-reminder cron (any long random string).
CRON_SECRET=

# Set to 1 when the portal goes live: Payroll and Employee Relations become HR-only
# (until then Admin can open them too, for testing).
RESTRICTED_HR_ONLY=
